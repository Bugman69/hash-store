{
  "id": "litecoin",
  "name": "Litecoin",
  "ticker": "LTC",
  "algo": "scrypt",
  "stratum_port": 3335,
  "address_regex": "^(ltc1[a-z0-9]{25,87}|[LM][a-km-zA-HJ-NP-Z1-9]{26,34})$",
  "address_hint": "ltc1... or L... / M...",
  "node_env": null,
  "note": "Example only. Copy to /data/coins/litecoin.json (drop the .example) once you run a Litecoin node and a scrypt stratum server. Only miners whose algo is scrypt can be switched to it."
}
